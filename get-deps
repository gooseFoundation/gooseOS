#!/bin/sh

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
RUN_DIR="$(pwd)"

# Update all the submodules
git submodule update --init --recursive

cd $RUN_DIR

echo "All dependencies have been downloaded, you can now run 'make' and 'make img'"